# Plantilla de variables de entorno.
# Copiar este archivo como `.env.local` y completar con valores reales.
# `.env.local` está en .gitignore y NO debe commitearse jamás.

# ─── App ───────────────────────────────────────────────────────────
# Base URL de la app, usada para construir redirectTo de Supabase
# (email confirmation, password reset).
# Dev local:   http://localhost:3000
# Producción:  http://46.225.63.21  (Plan A: HTTP plano sobre IP)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ──────────────────────────────────────────────────────
# Settings → API en el dashboard del proyecto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: solo backend (Server Actions, route handlers). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=
# PAT para la CLI (npm run db:*). Account → Access Tokens en supabase.com.
SUPABASE_ACCESS_TOKEN=

# ─── Stripe (Payment Links generados al crear invoice) ─────────────
# Pivote 2026-06-04: Stripe es el único método de cobro. Las invoices del
# admin generan Payment Links via API; el cliente paga ahí (out-of-app) y
# el webhook marca la invoice como 'paid'.
#
# Dev: usar sk_test_... (Stripe Dashboard → Developers → API keys, modo Test).
# Prod: rotar a sk_live_... en el .env del server.
STRIPE_SECRET_KEY=
# Firma del endpoint /api/stripe/webhook. Stripe Dashboard → Developers →
# Webhooks → "Add endpoint". Para dev local: `stripe listen --forward-to
# localhost:3000/api/stripe/webhook` imprime un whsec_... temporal.
STRIPE_WEBHOOK_SECRET=

# ─── SMTP transaccional (stand-by, proveedor no decidido) ──────────
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
