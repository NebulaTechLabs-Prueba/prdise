/coverage

# build / Next.js
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# configuración local de Claude Code (puede contener tokens/secrets)
.claude/

# variables de entorno (NUNCA commitear claves)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

