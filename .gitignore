# dependencias
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build / Next.js
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# configuración local de Claude Code (puede contener tokens/secrets)
.claude/

# variables de entorno (NUNCA commitear claves)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# debug
.pnpm-debug.log*

# editores
.vscode/
.idea/
*.swp
*.swo
*~

# sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# despliegue
.vercel
.turbo

# Supabase CLI — archivos locales/temporales (las migrations sí se commitean)
/supabase/.temp/
/supabase/.branches/

# notas privadas / borradores que no deben subirse
/notas-privadas/
/borradores/
*-credenciales*
*-secrets*
*.pem
*.key

# Catálogo del cliente (data cruda — no se commitea, se importa a Supabase
# vía scripts/import-catalog.mjs). docs/ permanece versionable para .md y
# otros assets internos; solo se ignoran los archivos de data.
/docs/*.xlsx
/docs/*.xls
/docs/*.csv
# Reviews / pedidos de ajustes del cliente en formato Word + imágenes
# adjuntas — son working documents, no documentación oficial del repo.
/docs/*.docx
/docs/Web Site Update*/

# Imágenes de servicios para asignar al catálogo. El admin las dropea aquí
# con nombre {slug}.{ext}; scripts/assign-service-images.mjs las sube a
# Supabase Storage y actualiza la DB. Los archivos NO se versionan porque
# son pesados y la fuente de verdad es Storage. Sí se commitea la carpeta
# vacía via .gitkeep para que exista en clones limpios.
/assets/service-images/*
!/assets/service-images/.gitkeep

# Scripts locales de diagnóstico / reset de usuarios de prueba.
# Uso del dev para depurar auth y resetear cuentas; no van a prod.
/scripts/auth-logs.mjs
/scripts/diagnose-signup.mjs
/scripts/reset-test-users.mjs
